# Core
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://reviewflow:reviewflow@localhost:5432/reviewflow
REDIS_URL=redis://localhost:6379

# S3 / Cloudflare R2 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=reviewflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PUBLIC_STORAGE_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# VBee
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_API_URL=https://api.vbee.vn/v1/tts
VBEE_CALLBACK_SECRET=replace-me

# Worker / FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_CONCURRENCY=2
TEMP_DIR=/tmp/reviewflow
